# Hiwonder STM32 main board via CH340 USB-serial (1a86:7523)
# - create a stable alias /dev/rrc
# - grant access to the 'dialout' group
# - tell ModemManager to ignore this port
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE="0660", GROUP="dialout", ENV{ID_MM_PORT_IGNORE}="1", SYMLINK+="rrc"
